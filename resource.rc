#define IDD_CONFIG_DIALOG   101
#define IDD_MAIN_WINDOW     102
#define IDD_INPUTBOX        103
#define IDD_PASSWORD_VERIFY  104
#define IDD_HELP_DIALOG     105

#define IDC_EDIT_PROGID     1001
#define IDC_EDIT_PORT       1002
#define IDC_EDIT_SLAVEID    1003
#define IDC_EDIT_INTERVAL   1004
#define IDC_EDIT_MAPPING    1005
#define IDC_BTN_BROWSE      1006
#define IDC_LIST_DATA       1007
#define IDC_BTN_SETTINGS    1008
#define IDC_STATUS_BAR      1009
#define IDC_BTN_RELOAD      1010
#define IDC_SERVER_STATUS   1011
#define IDC_EDIT_SERVERNAME 1012
#define IDC_EDIT_SERVERIP   1013
#define IDC_EDIT_USERNAME   1014
#define IDC_EDIT_PASSWORD   1015
#define IDC_LIST_REMOTE     1016
#define IDC_LIST_LOCAL      1017
#define IDC_BTN_BROWSE_REMOTE 1018
#define IDC_BTN_ADD         1019
#define IDC_BTN_DELETE      1020
#define IDC_BTN_ENCRYPT     1021
#define IDC_EDIT_INPUT      1022
#define IDC_BTN_EXPORT      1023
#define IDC_EDIT_VERIFY_PASS 1024
#define IDC_BTN_HELP        1025
#define IDC_HELP_EDIT       1026
#define IDC_AUTO_START      1027
#define IDC_EXPORT_STATUS   1030


#define IDC_STATIC_PROGID   2001
#define IDC_STATIC_PORT     2002
#define IDC_STATIC_SLAVEID  2003
#define IDC_STATIC_INTERVAL 2004
#define IDC_STATIC_MAPPING  2005
#define IDC_STATIC_PROMPT   2006
#define IDC_STATIC_USERNAME  2007

#define IDI_MAIN_ICON       201
#define IDI_TRAY_ICON       202

#include <windows.h>

// 配置对话框
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 451, 308
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "通讯参数设置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "远程 OPC 服务器", -1, 10, 10, 430, 200
    LTEXT           "名称:", -1, 29, 25, 25, 10
    EDITTEXT        IDC_EDIT_SERVERNAME, 50, 23, 120, 12, ES_AUTOHSCROLL
    LTEXT           "IP:", -1, 188, 25, 15, 10
    EDITTEXT        IDC_EDIT_SERVERIP, 200, 23, 80, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "枚举", IDC_BTN_BROWSE_REMOTE, 290, 22, 40, 14
    AUTOCHECKBOX    "开机自启动", IDC_AUTO_START, 377, 20, 60, 14
    LTEXT           "用户名:", -1, 20, 45, 35, 10
    EDITTEXT        IDC_EDIT_USERNAME, 50, 43, 119, 12, ES_AUTOHSCROLL
    LTEXT           "密码:", -1, 176, 44, 25, 10
    EDITTEXT        IDC_EDIT_PASSWORD, 200, 43, 80, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "加密", IDC_BTN_ENCRYPT, 290, 42, 40, 14
    CONTROL         "", IDC_LIST_REMOTE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 20, 65, 163, 142
    CONTROL         "", IDC_LIST_LOCAL, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 230, 65, 200, 142
    PUSHBUTTON      "添加 >", IDC_BTN_ADD, 186, 103, 40, 14
    PUSHBUTTON      "< 删除", IDC_BTN_DELETE, 186, 139, 40, 14
    EDITTEXT        IDC_EXPORT_STATUS, 332, 35, 105, 12, ES_READONLY | NOT WS_VISIBLE
    PUSHBUTTON      "导出条目", IDC_BTN_EXPORT, 377, 49, 50, 14
    GROUPBOX        "Modbus 设置", -1, 10, 215, 430, 63
    LTEXT           "Modbus 端口:", IDC_STATIC_PORT, 21, 232, 60, 10
    EDITTEXT        IDC_EDIT_PORT, 72, 230, 50, 12, ES_NUMBER
    LTEXT           "从站 ID:", IDC_STATIC_SLAVEID, 177, 232, 40, 10
    EDITTEXT        IDC_EDIT_SLAVEID, 208, 230, 50, 12, ES_NUMBER
    LTEXT           "刷新间隔(ms):", IDC_STATIC_INTERVAL, 309, 232, 65, 10
    EDITTEXT        IDC_EDIT_INTERVAL, 363, 230, 50, 12, ES_NUMBER
    LTEXT           "映射文件:", IDC_STATIC_MAPPING, 20, 254, 60, 10
    EDITTEXT        IDC_EDIT_MAPPING, 63, 252, 299, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...", IDC_BTN_BROWSE, 369, 252, 45, 14
    DEFPUSHBUTTON   "保存并启动", IDOK, 157, 285, 55, 14
    PUSHBUTTON      "取消", IDCANCEL, 270, 285, 55, 14
END

// 主窗口
IDD_MAIN_WINDOW DIALOGEX 0, 0, 860, 385
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU 
CAPTION "OPC -> Modbus TCP 网关"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LIST_DATA, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 10, 10, 535, 360
    LTEXT           "OPC服务器连接状态:", -1, 555, 10, 80, 10
    EDITTEXT        IDC_SERVER_STATUS, 555, 25, 295, 300, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT           "状态", IDC_STATUS_BAR, 555, 335, 295, 14
    PUSHBUTTON      "设置(&S)...", IDC_BTN_SETTINGS, 585, 355, 50, 14
    PUSHBUTTON      "重新加载映射(&R)", IDC_BTN_RELOAD, 665, 355, 80, 14
    PUSHBUTTON      "帮助(&H)", IDC_BTN_HELP, 775, 355, 50, 14
END

// 密码输入框
IDD_INPUTBOX DIALOGEX 0, 0, 200, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入密码"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "请输入明文密码:", IDC_STATIC_PROMPT, 10, 10, 180, 10
    EDITTEXT        IDC_EDIT_INPUT, 10, 24, 180, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 50, 45, 40, 14
    PUSHBUTTON      "取消", IDCANCEL, 100, 45, 40, 14
END

IDD_PASSWORD_VERIFY DIALOGEX 0, 0, 200, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "密码验证"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "当前用户:", -1, 10, 10, 50, 10
    LTEXT           "", IDC_STATIC_USERNAME, 65, 10, 120, 10
    LTEXT           "密码:", -1, 10, 30, 30, 10
    EDITTEXT        IDC_EDIT_VERIFY_PASS, 45, 28, 140, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 50, 55, 40, 14
    PUSHBUTTON      "取消", IDCANCEL, 100, 55, 40, 14
END

IDD_HELP_DIALOG DIALOGEX 480, 0, 370, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "帮助文档"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_HELP_EDIT, 10, 10, 360, 280, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_HSCROLL
END

// 图标
IDI_MAIN_ICON       ICON      "app.ico"
IDI_TRAY_ICON       ICON      "tray.ico"
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,3,0,0
PRODUCTVERSION  3,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"       // 中文简体，Unicode
        BEGIN
            VALUE "CompanyName", "YXL"
            VALUE "FileDescription", "OPC to Modbus TCP Gateway"
            VALUE "FileVersion", "3.2.0.0"
            VALUE "InternalName", "OPC2ModbusV3"
            VALUE "LegalCopyright", "Copyright (C) 2025"
            VALUE "OriginalFilename", "OPC2MODBUSV3.exe"
            VALUE "ProductName", "OPC2Modbus"
            VALUE "ProductVersion", "3.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04B0  // 中文简体, Unicode
    END
END